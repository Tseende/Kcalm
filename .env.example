TELEGRAM_BOT_TOKEN=
ALLOWED_TG_IDS=
# Оставь false для личного бота. true допустимо только для осознанного публичного теста.
ALLOW_PUBLIC_BOT=false
OPENROUTER_API_KEY=
MODEL_VISION=deepseek/deepseek-v4.1-flash-1017
MODEL_VISION_ESCALATION=deepseek/deepseek-v4.1-flash
MODEL_TEXT=deepseek/deepseek-v4.1-flash-1017
USDA_API_KEY=DEMO_KEY
PICOOC_USER=
PICOOC_PASSWORD=
DB_PATH=./data/health.db
TZ=Europe/Minsk
DAILY_KCAL_TARGET_DEFAULT=
EATING_CUTOFF=21:00
LOG_LEVEL=INFO
MAX_MEDIA_BYTES=10485760
# Чей Picooc (tg id). Пусто = единственный из ALLOWED_TG_IDS. Строку раскомментируй, только заполнив значение.
# PICOOC_OWNER_TG_ID=123456789
# Куда класть бэкапы (лучше внешний диск) и где лежат фото. Строки можно не менять.
# BACKUP_DIR=./data/backups
# PHOTOS_DIR=./data/photos
# false, если бэкап запускает systemd-таймер из deploy/
# BACKUP_IN_PROCESS=true
# MODEL_TEXT_PROVIDER=DeepSeek   # по умолчанию уже DeepSeek; пусто — не закреплять
# MODEL_ASR=google/gemini-2.5-flash   # только голос: DeepSeek аудио не принимает
# KEEPALIVE_HOURS=1   # Render free: после любой активности не засыпать ещё N часов (самопинг), потом сон
# KEEPALIVE_WINDOW=08:00-23:30   # или фиксированное окно: не засыпать днём (можно вместе с KEEPALIVE_HOURS)
# KEEPALIVE_TZ=Europe/Minsk   # часовой пояс для KEEPALIVE_WINDOW
# Лимит обращений к модели на человека в сутки (UTC): защита от слива баланса. 0 = без лимита. Разговор о тяге не считается.
DAILY_LLM_LIMIT=200
# Секрет заголовка webhook Telegram (A-Za-z0-9_-). Пусто = производный от токена бота (стабилен между рестартами)
# WEBHOOK_SECRET=
# MODEL_TEXT_REASONING=false   # true включает «думающий» режим текстовой модели

# Красивые ответы с таблицами (нужен Telegram с поддержкой Bot API 10.1). false = обычный текст
RICH_MESSAGES=true

# Mini App: веб-сервер в процессе бота. WEBAPP_URL — публичный HTTPS-адрес, например https://example.com/app/
WEB_ENABLED=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEBAPP_URL=
# Только для локальной разработки (python -m app.web.dev): tg id, под которым открывается приложение без Telegram
# Облако (Render + Turso), см. docs/DEPLOY_RENDER.md. Пусто = локальный SQLite и polling.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
WEBHOOK_BASE_URL=
WEB_DEV_TG_ID=
